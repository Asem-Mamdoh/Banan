# AI sales agent (server-side). Set at least one provider on Vercel Project → Settings → Environment Variables.
# Gemini: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Or OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: if the chat API is hosted elsewhere, point the browser to it (production usually leave unset).
# VITE_CHAT_API_URL=https://your-deployment.vercel.app
